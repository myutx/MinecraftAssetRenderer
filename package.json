{
  "name": "minecraft-asset-renderer",
  "version": "1.0.0",
  "description": "Server-side Minecraft item, head, and sprite rendering.",
  "author": "myutx",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "test": "pnpm build && node --test test/*.test.ts",
    "check": "pnpm build"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "6.0.3"
  },
  "license": "AGPL-3.0-only",
  "private": true
}
